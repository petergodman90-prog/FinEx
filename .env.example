# --- App ---
APP_ENV=local
APP_NAME=FINEX

# --- Database ---
POSTGRES_USER=finex
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=finex
# Runtime connection. In production this MUST be the restricted finex_app
# login role, never the owner/superuser used to run migrations.
DATABASE_URL=postgresql+asyncpg://finex:change_me_local_only@127.0.0.1:5432/finex
# Optional owner/migration role; Alembic falls back to DATABASE_URL when empty.
# Production: set this to the schema owner and keep DATABASE_URL as finex_app.
MIGRATION_DATABASE_URL=

# --- Browser access ---
# Comma-separated origins for direct browser calls (local static server only).
# Leave empty when the UI and API are served from the same origin.
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# --- Redis ---
REDIS_URL=redis://127.0.0.1:6379/0

# --- Auth ---
JWT_SECRET=change_me_local_only
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=20160

# --- PII encryption (generate your own; NEVER commit real keys) ---
#   Fernet key : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   HMAC key   : python -c "import secrets; print(secrets.token_hex(32))"
PII_ENCRYPTION_KEY=
PII_HMAC_KEY=

# --- AI (fill later, never commit real keys) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- WhatsApp (fill later) ---
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=