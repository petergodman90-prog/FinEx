# --- App ---
APP_ENV=local
APP_NAME=FINEX

# --- Database ---
POSTGRES_USER=finex
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=finex
# Runtime connection. In production this MUST be the restricted finex_app
# login role, never the owner/superuser used to run migrations.
DATABASE_URL=postgresql+asyncpg://finex:change_me_local_only@127.0.0.1:5432/finex
# Optional owner/migration role; Alembic falls back to DATABASE_URL when empty.
# Production: set this to the schema owner and keep DATABASE_URL as finex_app.
MIGRATION_DATABASE_URL=

# --- Browser access ---
# Local full-stack default: FastAPI serves the public UI at / and the API at
# /api/v1 from one origin. Set false when a reverse proxy serves the frontend.
SERVE_FRONTEND=true
# Forced true automatically when APP_ENV=production. Set true explicitly for
# HTTPS deployments that do not use APP_ENV=production.
COOKIE_SECURE=false
# Comma-separated origins for direct browser calls (separate static server
# development only). Keep empty for the same-origin setup above.
CORS_ORIGINS=

# --- Redis ---
REDIS_URL=redis://127.0.0.1:6379/0

# --- Auth ---
JWT_SECRET=change_me_local_only
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=20160

# Redis-backed limits for unauthenticated auth endpoints. Set
# AUTH_RATE_LIMIT_ENABLED=false only for isolated local testing.
AUTH_RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_PER_MINUTE=10
LOGIN_ACCOUNT_RATE_LIMIT_PER_MINUTE=5
REGISTER_RATE_LIMIT_PER_HOUR=10
REFRESH_RATE_LIMIT_PER_MINUTE=30

# --- PII encryption (generate your own; NEVER commit real keys) ---
#   Fernet key : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   HMAC key   : python -c "import secrets; print(secrets.token_hex(32))"
PII_ENCRYPTION_KEY=
PII_HMAC_KEY=

# --- AI (fill later, never commit real keys) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- WhatsApp (fill later) ---
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=